# ==========================================================================
# SUPABASE (obrigatório)
# Crie um projeto gratuito em https://supabase.com e copie os valores em
# Project Settings > API
# ==========================================================================

# URL pública do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chave pública (anon/public) — segura para uso no browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chave service_role — NUNCA exponha no frontend. Usada apenas em rotas de
# servidor (API routes / server actions) para operações administrativas,
# como leitura de storage privado durante o parsing de currículo.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==========================================================================
# IA (opcional)
# Se não configurada, o sistema funciona normalmente: resumos de currículo,
# explicações de match e sugestões de melhoria ficam limitados às versões
# geradas pelo algoritmo local (lib/matching), sem chamadas de IA.
# ==========================================================================
ANTHROPIC_API_KEY=

# ==========================================================================
# FONTES DE VAGAS (opcional)
# As fontes públicas (Remotive, Arbeitnow) não exigem chave e já funcionam
# sem configuração. Variáveis abaixo existem apenas para fontes que exigem
# credencial própria (ex.: um futuro parceiro com feed XML autenticado).
# Enquanto não configuradas, o adaptador correspondente permanece inativo
# e o sistema continua funcionando com as demais fontes + modo DEMO.
# ==========================================================================
INDEED_PARTNER_FEED_URL=
INDEED_PARTNER_API_KEY=

# ==========================================================================
# APP
# ==========================================================================
# URL pública da aplicação (usada em callbacks de auth e links de e-mail)
NEXT_PUBLIC_APP_URL=http://localhost:3000
